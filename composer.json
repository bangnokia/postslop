{
    "name": "postslop/postslop",
    "description": "A local social publishing workspace built on CrabPHP",
    "type": "project",
    "require": {
        "php": "^8.4",
        "crabphp/framework": "dev-main"
    },
    "require-dev": {
        "carthage-software/mago": "1.57.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "format": "@php vendor/bin/mago fmt",
        "format:check": "@php vendor/bin/mago fmt --check",
        "lint": "@php vendor/bin/mago lint"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/crabphp/framework"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
