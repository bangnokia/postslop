#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

try {
    $app = require __DIR__ . '/app.php';
} catch (Throwable $error) {
    fwrite(
        STDERR,
        '[Crab] '
        . $error->getMessage()
        . ' ('
        . $error->getFile()
        . ':'
        . $error->getLine()
        . ")\n"
        . "The application could not load; this command did not contact the running server.\n"
        . "Restore the last working application files, or use the previous release with the same shared storage, then retry.\n",
    );
    exit(1);
}

$arguments = array_slice($argv, 1);
$status = $app->console->run($arguments);
exit($status);
