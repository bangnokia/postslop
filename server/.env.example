APP_NAME=Postslop
APP_DEBUG=false
APP_URL=http://127.0.0.1:8087
SERVER_ADDRESS=tcp://0.0.0.0:8087
SERVER_WORKERS=1
SERVER_QUEUE=true
SERVER_SCHEDULE=true
CACHE_STORE=file
LOG_LEVEL=debug
POSTSLOP_X_TRANSPORT=browser
# The web client and HTTP API password. Leave it empty and both are open to anyone who can reach the server.
POSTSLOP_TOKEN=change-me
